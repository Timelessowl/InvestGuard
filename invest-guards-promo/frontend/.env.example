# A MapLibre Style JSON URL. Rebuild after changing providers.
# For another host, update connect-src / img-src in nginx.conf and provider attribution.
VITE_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/positron

# Vite dev/preview forwards API calls to the running Compose stack.
API_PROXY_TARGET=http://127.0.0.1:18473
