APP_BIND=
APP_PORT=
AUTH_USERNAME=poc_user
# Required: choose a strong, unique ASCII password. Empty passwords prevent API startup.
AUTH_PASSWORD=
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=
LLM_BASE_URL=
LLM_API_KEY=
LLM_TRIAGE_MODEL=
LLM_SMART_MODEL=
LLM_EMBED_MODEL=
LLM_BUDGET_USD=45
LLM_DAILY_BUDGET_USD=3
LLM_PRICES_JSON='{}'
PIPELINE_INTERVAL_SECONDS=60
PIPELINE_BATCH=20
FOCUS_API_KEY=
FOCUS_INN_LIMIT=950
FOCUS_AUTO_CHECK=1

# Source runner and event linking
# HTTP attempts per request inside one run; 1 = no retries
SOURCE_RETRY_ATTEMPTS=3
SOURCE_BACKOFF_BASE_MINUTES=5
SOURCE_MAX_RETRY_AFTER=300
SOURCE_RUN_STALE_MINUTES=60
EVENT_LINK_BATCH=200
FOCUS_AUTO_CHECK_EVENTS=0
LINKING_RULES_PATH=
# «Работа России»: open data API, no key. Region code from the API (region.region_code)
TRUDVSEM_BASE_URL=https://opendata.trudvsem.ru/api/v1
TRUDVSEM_REGION_CODE=6600000000000
TRUDVSEM_PAGE_DELAY_SECONDS=0.5
# the API answers in 12-15 s per request
TRUDVSEM_TIMEOUT_SECONDS=60
# pages per run; the rest continues next run by cursor
TRUDVSEM_MAX_PAGES=300
# a vacancy missing from two full exports in a row is closed
TRUDVSEM_FULL_SYNC_DAYS=7
# next increment starts this much before the latest date_modify received
TRUDVSEM_OVERLAP_MINUTES=60
# Own profession dictionary and hiring thresholds instead of backend/seed/*.json
VACANCY_CATEGORIES_PATH=
HIRING_SIGNALS_PATH=

# Product analytics (docker compose --profile analytics up -d)
UMAMI_WEBSITE_ID=
UMAMI_APP_SECRET=
UMAMI_ADMIN_PASSWORD=
UMAMI_DB_PASSWORD=
UMAMI_DATABASE_URL=
UMAMI_DOMAIN=
UMAMI_BIND=127.0.0.1
UMAMI_PORT=18474
# Server LAN dashboard (only with compose.lan.yaml); use the server's private IPv4.
UMAMI_LAN_BIND=192.168.1.111
